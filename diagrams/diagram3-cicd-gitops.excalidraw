    {
      "type": "text",
      "id": "t_note",
      "x": 60,
      "y": 490,
      "width": 1760,
      "height": 50,
      "text": "GitOps rule: Git = source of truth.  No direct kubectl apply in UAT/Public.  Argo CD = only deploy mechanism.\nArgo CD UI: argocd.company.com (VPN only)  |  CLI: argocd app sync  |  Auto sync interval: ~3 min (or webhook for instant)",
      "originalText": "GitOps rule: Git = source of truth.  No direct kubectl apply in UAT/Public.  Argo CD = only deploy mechanism.\nArgo CD UI: argocd.company.com (VPN only)  |  CLI: argocd app sync  |  Auto sync interval: ~3 min (or webhook for instant)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
