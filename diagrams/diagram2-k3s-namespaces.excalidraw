    { "type": "text", "id": "t_certmgr", "x": 546, "y": 96, "width": 358, "height": 188,
      "text": "cert-manager\n──────────────────────────────────\nClusterIssuer: letsencrypt-http\nIssuer: Let's Encrypt (ACME)\nChallenge: HTTP01 via Traefik\n\nAuto-issues TLS certs\nfor all domains in cluster\n[port 80 must be public]",
      "originalText": "cert-manager\n──────────────────────────────────\nClusterIssuer: letsencrypt-http\nIssuer: Let's Encrypt (ACME)\nChallenge: HTTP01 via Traefik\n\nAuto-issues TLS certs\nfor all domains in cluster\n[port 80 must be public]",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 30302, "version": 1, "versionNonce": 30303, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.45 },

    { "type": "rectangle", "id": "r_argocd", "x": 945, "y": 88, "width": 490, "height": 205,
      "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid",
