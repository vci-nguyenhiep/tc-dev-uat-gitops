    { "type": "text", "id": "t_kubesys", "x": 96, "y": 96, "width": 398, "height": 188,
      "text": "kube-system\n──────────────────────────────────\nTraefik  (Ingress Controller)\nCoreDNS  (cluster DNS)\nmetrics-server  (resource usage)\nlocal-path-provisioner  (storage)\n\n[built-in k3s components]",
