    { "type": "text", "id": "t_argocd", "x": 956, "y": 96, "width": 468, "height": 188,
      "text": "argocd  [VPN only]\n──────────────────────────────────\nArgo CD  (GitOps engine)\nargocd.company.com  (VPN only)\n\nPolls GitOps repo every ~3 min\nSyncs Git state → k3s\npruneResources: true\nselfHeal: configurable per app",
      "originalText": "argocd  [VPN only]\n──────────────────────────────────\nArgo CD  (GitOps engine)\nargocd.company.com  (VPN only)\n\nPolls GitOps repo every ~3 min\nSyncs Git state → k3s\npruneResources: true\nselfHeal: configurable per app",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 30402, "version": 1, "versionNonce": 30403, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.45 },

