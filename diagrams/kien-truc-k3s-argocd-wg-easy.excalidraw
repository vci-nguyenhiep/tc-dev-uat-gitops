    {
      "id": "t_cicd_flow",
      "type": "text",
      "x": 2758.224160337309,
      "y": 1077.1319971890912,
      "width": 340,
      "height": 220,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1060,
      "version": 89,
      "versionNonce": 3138681,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "text": "CI/CD Flow:\n1. Dev push code\n2. CI build & test\n3. Push image to registry\n4. Update image tag\n   in GitOps repo\n5. ArgoCD detects change\n6. ArgoCD syncs to k3s\n\nBranch → Namespace:\ndevelop → dev\nuat/* → uat\nmain → public",
      "originalText": "CI/CD Flow:\n1. Dev push code\n2. CI build & test\n3. Push image to registry\n4. Update image tag\n   in GitOps repo\n5. ArgoCD detects change\n6. ArgoCD syncs to k3s\n\nBranch → Namespace:\ndevelop → dev\nuat/* → uat\nmain → public",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "index": "ax",
      "updated": 1781086852428,
      "autoResize": true
    },
    {
      "id": "t_network_policy",
      "type": "text",
      "x": 1459.7686603640873,
      "y": 1320.9068203764857,
      "width": 1110,
      "height": 132,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1061,
      "version": 48,
      "versionNonce": 1324537335,
      "isDeleted": false,
      "boundElements": [],
      "link": null,
      "locked": false,
      "text": "NetworkPolicy:\n- default-deny-ingress cho: dev, uat, data namespaces\n- dev pods chỉ reach dev-postgres / dev-redis (label env=dev)\n- uat pods chỉ reach uat-postgres / uat-redis (label env=uat)\n- Cross-namespace access bị chặn",
      "originalText": "NetworkPolicy:\n- default-deny-ingress cho: dev, uat, data namespaces\n- dev pods chỉ reach dev-postgres / dev-redis (label env=dev)\n- uat pods chỉ reach uat-postgres / uat-redis (label env=uat)\n- Cross-namespace access bị chặn",
